# 50 MHz board clock
create_clock -name CLOCK_50 -period 20.000 [get_ports CLOCK_50]

# 40 MHz clock generated by pll40 (ALTPLL) from CLOCK_50
derive_pll_clocks
derive_clock_uncertainty

# The JTAG clock (altera_reserved_tck) that clocks alt_jtag_atlantic is created
# automatically by Quartus, and the SLD/JTAG-Atlantic logic crosses into the
# clk40 domain through its own synchronisers. Cut those paths, same as
# COUNTER_JTAG/de0cv_counter_jtag.sdc.
if {[llength [get_clocks -nowarn altera_reserved_tck]] > 0} {
    set_clock_groups -asynchronous \
        -group [get_clocks {CLOCK_50 *pll40*clk[0]*}] \
        -group [get_clocks altera_reserved_tck]
}

# Push-button and LEDs are asynchronous / not timing-critical
set_false_path -from [get_ports {KEY[*]}]  -to [all_registers]
set_false_path -from * -to [get_ports {LEDR[*]}]

# The ring oscillators are free-running combinational feedback loops by
# design (that is the entropy source) -- they are not meant to close static
# timing, and the single sampler flip-flop is deliberately capturing an
# asynchronous, glitchy signal (any resulting metastability just adds more
# jitter/entropy, it is not a bug to fix). Quartus reports a critical warning
# about the combinational loops inside each ring_oscillator instance; that is
# expected and does not block compilation. Cut the sampler's input path so
# STA does not try to time it.
set_false_path -to [get_registers {*sampled_bit*}]
