set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C7
set_global_assignment -name TOP_LEVEL_ENTITY de0cv_trng
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4

# The design is dominated by 114 free-running, unconstrained ring-oscillator
# combinational loops with no real timing objective; timing-driven placement
# effort spent on them is wasted and made the fitter extremely slow. Fast/area
# fitting is plenty for the one real timing requirement here (the ~40 MHz
# packer/jtag_uart_tx logic, which is trivially easy to close).
set_global_assignment -name FITTER_EFFORT FAST_FIT
set_global_assignment -name OPTIMIZATION_TECHNIQUE AREA

set_global_assignment -name VHDL_FILE ring_oscillator.vhd
set_global_assignment -name VHDL_FILE pll40.vhd
set_global_assignment -name VHDL_FILE von_neumann.vhd
set_global_assignment -name VHDL_FILE trng_packer.vhd
set_global_assignment -name VHDL_FILE jtag_uart_tx.vhd
set_global_assignment -name VHDL_FILE de0cv_trng.vhd

set_global_assignment -name SDC_FILE de0cv_trng.sdc

# CLOCK_50, KEY(0), LEDR(9:0) -- same DE0-CV pin locations as COUNTER_JTAG
set_location_assignment PIN_M9 -to CLOCK_50
set_location_assignment PIN_U7 -to KEY[0]
set_location_assignment PIN_AA2 -to LEDR[0]
set_location_assignment PIN_AA1 -to LEDR[1]
set_location_assignment PIN_W2 -to LEDR[2]
set_location_assignment PIN_Y3 -to LEDR[3]
set_location_assignment PIN_N2 -to LEDR[4]
set_location_assignment PIN_N1 -to LEDR[5]
set_location_assignment PIN_U2 -to LEDR[6]
set_location_assignment PIN_U1 -to LEDR[7]
set_location_assignment PIN_L2 -to LEDR[8]
set_location_assignment PIN_L1 -to LEDR[9]

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top