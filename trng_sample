#!/bin/bash
# Captura contínua do stream JTAG-Atlantic até atingir TARGET bytes.
# Uso recomendado (sobrevive a fechar o terminal e impede suspensão):
#   nohup systemd-inhibit --what=sleep:idle ./trng_sample > capture/trng_sample.out 2>&1 &

cd "$HOME/altera_lite/25.1std/quartus/codes/DE0CV/trng" || exit 1
export QUARTUS_ROOTDIR="$HOME/altera_lite/25.1std/quartus"
export PATH="$QUARTUS_ROOTDIR/bin:$PATH"

OUT=capture/trng_1gbit.bin
LOG=capture/trng_1gbit.log
TARGET=$((1 << 31))   # 2 GiB
CHUNK=300             # segundos por execução do juart-terminal

mkdir -p capture
touch "$OUT"
n=0
while :; do
  sz=$(stat -c %s "$OUT")
  if [ "$sz" -ge "$TARGET" ]; then
    echo "$(date '+%F %T') TARGET REACHED: $sz bytes"
    break
  fi
  n=$((n+1))
  echo "$(date '+%F %T') run #$n start size=$sz" >> "$LOG"
  juart-terminal -c 1 --no-quit-on-ctrl-d --persistent -o "$CHUNK" -q >> "$OUT" 2>> "$LOG" < /dev/null
  rc=$?
  new=$(stat -c %s "$OUT")
  rate=$(( (new - sz) / CHUNK ))
  echo "$(date '+%F %T') run #$n: exit=$rc size=$new (+$((new - sz)) B, ~$rate B/s, $((new * 100 / TARGET))%)"
  # se nada chegou, dá tempo ao jtagd/cabo se recuperarem
  [ "$new" -eq "$sz" ] && sleep 5
done

# arquivo com exatamente 2^31 bytes
head -c "$TARGET" "$OUT" > capture/trng_2GiB.bin
ls -l capture/trng_2GiB.bin
